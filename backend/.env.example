# =============================================
# Soly Platform - Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Database
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-32

# JWT (min 32 chars, generate with: openssl rand -base64 32)
JWT_SECRET=change-me

# Supabase keys (generate with: openssl rand -hex 16)
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me

# URLs
PUBLIC_URL=https://your-domain.com
SITE_URL=https://your-domain.com
ALLOWED_URLS=https://your-domain.com,https://www.your-domain.com

# SMTP (for auth emails - password reset, confirmation)
SMTP_ADMIN_EMAIL=admin@soly.app
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM=Soly <no-reply@soly.app>

# Flow.cl (payment gateway)
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BUSINESS_PLAN_ID=
